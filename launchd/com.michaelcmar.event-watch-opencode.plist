<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.michaelcmar.event-watch-opencode</string>

    <!-- Runs run-event-watch-opencode.sh, which itself calls opencode run
         with the model and prompt body pulled from the command file,
         plus the auto flag. It's a wrapper instead of a plain
         `opencode run` against the /event-watch command because opencode
         run does not resolve custom slash commands (open upstream bug)
         — see the comment at the top of that script for details. If that
         ever gets fixed upstream, this plist can point straight at
         opencode again.

         Before enabling this job, confirm:
           - `opencode auth login` has been run once to connect the OpenRouter
             provider (stores the API key in opencode's own credential store,
             not in this repo, so it's never committed).
           - The Gmail MCP server's one-time OAuth consent has been completed
             so its refresh token is cached under ~/.gmail-mcp/ and future
             runs need no browser interaction.
         Update the paths below if this repo or the opencode binary ever move. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/michaelcmar/Projects/event-watch/launchd/run-event-watch-opencode.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/michaelcmar/Projects/event-watch</string>

    <!-- launchd does not source your shell profile, so PATH must be set explicitly.
         Run `which node` locally and add its directory here if the job fails to
         find it (opencode needs it to spawn the Gmail MCP server via npx).

         OPENCODE_ENABLE_EXA turns on opencode's built-in websearch/webfetch
         tools (Exa-hosted, no separate API key needed); they're off by
         default. Do NOT put OPENROUTER_API_KEY or any Gmail credential here;
         both are meant to live in their own local credential stores set up
         via the one-time interactive steps above, not in this plist (which
         could end up committed to the repo alongside the others). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/michaelcmar</string>
        <key>OPENCODE_ENABLE_EXA</key>
        <string>true</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/michaelcmar/Projects/event-watch/logs/event-watch-opencode.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/michaelcmar/Projects/event-watch/logs/event-watch-opencode.err.log</string>

    <!-- Every day at 6:00 AM local time. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
</dict>
</plist>
